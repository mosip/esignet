# Your credentials overlay — the ONLY config file that should hold a secret.
# The per-plugin files (config.mock/mosip/sunbird.json) ARE tracked: they define
# what the tests do, so they belong under review. Keeping secrets out of them
# means you never edit a tracked file to add one, and a dirty config.mosip.json
# always means a real change worth reviewing.
config.local.json

# Pre-existing local config from before the per-plugin split.
config.json

# docker compose env overrides (secrets: KEYCLOAK_CLIENT_SECRET etc.)
.env

# The suite plan config with PRIVATE jwks must never be committed.
# Keep it outside the repo (see config_file in config.json) or here if you must:
*esignet-config*.json
conformance-suite-private/

# Report output
out/
*.report.html

# Go build artifacts — `go build ./...` drops one per cmd/ package here
/conformance
/conformance.exe
/e2e
/e2e.exe
/consolidate
/consolidate.exe
/cfg
/cfg.exe
