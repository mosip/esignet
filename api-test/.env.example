# Copy to .env (gitignored) and fill in for `docker compose up`. See README.md
# "Running via Docker Compose" for details; env names match run-all.sh / the
# conformance config env overrides (design: mosip/esignet#2120).

# Required — either a deployed environment:
ESIGNET_BASE_URL=https://esignet-thunder1.esdev.mosip.net/v1/esignet
# ...or an eSignet you're running yourself on this host (`make.sh run` /
# `go run ./cmd/esignet` / your own compose in ../esignet-service), reached via
# the harness container's Docker-provided host alias:
# ESIGNET_BASE_URL=http://host.docker.internal:8080

# Which surfaces / plugin / conformance profile
PLUGIN=mock
SURFACES=conformance,bdd,e2e
TEST_PROFILE=smoke

# client-mgmt + e2e admin auth (Keycloak client-credentials grant)
KEYCLOAK_TOKEN_URL=https://iam.esdev.mosip.net/auth/realms/mosip/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=mosip-pms-client
KEYCLOAK_CLIENT_SECRET=

# Test identity for the plugin under test
INDIVIDUAL_ID=
ID_TYPE=
TEST_USERNAME=
TEST_PASSWORD=
TEST_OTP=111111

# sunbird KBI identity (only if PLUGIN=sunbird)
KBI_FULL_NAME=
KBI_DOB=

# mosipid specifics (only if PLUGIN=mosip) — see README "mosipid specifics"
PMS_BASE_URL=
AUTH_PARTNER_ID=
AUTH_POLICY_ID=
OTP_SOURCE=static
OTP_WS_URL=
OTP_RECIPIENT_EMAIL=

# Conformance suite image tag. Keep this in step with "suite_version" in
# profiles/oidcc-test-plan.smoke.json — the smoke allow-list is curated against
# that release. See https://gitlab.com/openid/conformance-suite/-/releases
SUITE_IMAGE_TAG=release-v5.1.41
