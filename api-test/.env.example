# Copy to .env (gitignored) for `docker compose up`.
#
# Configuration now lives in the per-plugin config files (config.mock.json,
# config.mosip.json, config.sunbird.json) plus your gitignored config.local.json
# overlay — not here. This file selects WHICH plugin config to mount and carries
# only the values that differ per run. Anything set here overrides both config
# layers, so you can still pin any field ad hoc.
#
# First run:
#   cp config.local.example.json config.local.json   # <- required, it is mounted
#   cp .env.example .env
#   docker compose up --build --abort-on-container-exit --exit-code-from harness

# Which plugin config to mount as /app/config.json
CONFIG_FILE=config.mock.json

# Conformance suite image tag. Keep this in step with "suite_version" in
# profiles/oidcc-test-plan.smoke.json — the smoke allow-list is curated against
# that release. See https://gitlab.com/openid/conformance-suite/-/releases
SUITE_IMAGE_TAG=release-v5.1.41

# ---------------------------------------------------------------------------
# Optional overrides. Leave blank to use whatever config.<plugin>.json and
# config.local.json already say.
# ---------------------------------------------------------------------------

# Target eSignet. Either a deployed environment...
ESIGNET_BASE_URL=
# ...or one you run yourself on this host (`make.sh run` / `go run ./cmd/esignet`
# in ../esignet-service), reached via the container's Docker host alias:
# ESIGNET_BASE_URL=http://host.docker.internal:8080

# Secrets, if you would rather not keep them in config.local.json
KEYCLOAK_CLIENT_SECRET=
INDIVIDUAL_ID=

# Narrow the run without editing the config file
SURFACES=
TEST_PROFILE=
