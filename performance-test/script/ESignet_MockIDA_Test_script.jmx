            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate PKCE" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.security.MessageDigest
import java.security.SecureRandom
byte[] rnd = new byte[32]
new SecureRandom().nextBytes(rnd)
def b64url = { byte[] b -&gt; b.encodeBase64().toString().replace(&apos;+&apos;, &apos;-&apos;).replace(&apos;/&apos;, &apos;_&apos;).replaceAll(&apos;=&apos;, &apos;&apos;) }
def verifier = b64url(rnd)
def challenge = b64url(MessageDigest.getInstance(&apos;SHA-256&apos;).digest(verifier.getBytes(&apos;UTF-8&apos;)))
vars.put(&apos;code_verifier&apos;, verifier)
vars.put(&apos;code_challenge&apos;, challenge)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate DPoP Key and Proof (PAR)" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">/*
 * FAPI2: generate a fresh DPoP RSA key pair (PS256) and the DPoP proof for the PAR
 * endpoint. Ported from Postman &apos;Initiate PAR&apos; pre-request script.
 * Requires nimbus-jose-jwt + bcprov/bcpkix jars (already used elsewhere in this plan).
 */
import com.nimbusds.jose.*
import com.nimbusds.jwt.*
import com.nimbusds.jose.jwk.*
import com.nimbusds.jose.jwk.gen.*
import com.nimbusds.jose.crypto.RSASSASigner
import java.util.UUID
import java.util.Date


def htu = vars.get(&quot;protocol&quot;) + &quot;://&quot; + vars.get(&quot;serverIP&quot;) + &quot;/v1/esignet/oauth2/par&quot;
// Fresh DPoP key pair per iteration (mirrors Postman behaviour)
// OPTIMIZED: one DPoP key pair per THREAD, generated on the first iteration and
// reused afterwards. RFC 9449 allows key reuse; only the proof JWT (jti/iat)
// must be fresh, and it still is - built below on every iteration.
def rsaJwk = (RSAKey) vars.getObject(&quot;dpopRsaJwkObj&quot;)
if (rsaJwk == null) {
    rsaJwk = new RSAKeyGenerator(2048).generate()
    vars.putObject(&quot;dpopRsaJwkObj&quot;, rsaJwk)
}
vars.put(&quot;dpopPrivateJwk&quot;, rsaJwk.toJSONString())

// dpop_jkt = RFC7638 SHA-256 thumbprint of the public JWK
def jkt = rsaJwk.toPublicJWK().computeThumbprint().toString()
vars.put(&quot;dpopJkt&quot;, jkt)

// DPoP proof JWT: typ=dpop+jwt, alg=PS256, jwk=public key; htm/htu/iat/jti claims
def header = new JWSHeader.Builder(JWSAlgorithm.PS256)
    .type(new JOSEObjectType(&quot;dpop+jwt&quot;))
    .jwk(rsaJwk.toPublicJWK())
    .build()
def claims = new JWTClaimsSet.Builder()
    .jwtID(UUID.randomUUID().toString())
    .claim(&quot;htm&quot;, &quot;POST&quot;)
    .claim(&quot;htu&quot;, htu)
    .issueTime(new Date())
    .build()
def jwt = new SignedJWT(header, claims)
def signer = new RSASSASigner(rsaJwk)
jwt.sign(signer)
vars.put(&quot;dpopProofPar&quot;, jwt.serialize())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Client Assertion PS256 (PAR)" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">/*
 * FAPI2: PS256 private_key_jwt client assertion for the PAR endpoint
 * (aud = https://host/v1/esignet/oauth2/par), signed with unencryptedPrivateKey JWK.
 * Ported from Postman &apos;Initiate PAR&apos; pre-request script (buildClientAssertion).
 */
import com.nimbusds.jose.*
import com.nimbusds.jwt.*
import com.nimbusds.jose.jwk.*
import com.nimbusds.jose.crypto.RSASSASigner
import java.util.UUID
import java.util.Date

def jwk = JWK.parse(vars.get(&quot;unencryptedPrivateKey&quot;))
def clientId = vars.get(&quot;userInfoClientId&quot;)
def aud = vars.get(&quot;tokenAudience&quot;)
def kid = jwk.getKeyID()
if (kid == null || kid.isEmpty()) {
    kid = jwk.toPublicJWK().computeThumbprint().toString()
}
def header = new JWSHeader.Builder(JWSAlgorithm.PS256)
    .type(JOSEObjectType.JWT)
    .keyID(kid)
    .build()
def now = new Date()
def claims = new JWTClaimsSet.Builder()
    .issuer(clientId)
    .subject(clientId)
    .audience(aud)
    .jwtID(UUID.randomUUID().toString())
    .issueTime(now)
    .expirationTime(new Date(now.getTime() + 60000))
    .build()
def jwt = new SignedJWT(header, claims)
def signer = new RSASSASigner((RSAKey) jwk)
jwt.sign(signer)
vars.put(&quot;clientAssertionPAR&quot;, jwt.serialize())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
