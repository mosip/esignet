              <stringProp name="script">import com.nimbusds.jose.*
import com.nimbusds.jose.crypto.*
import com.nimbusds.jwt.*
import com.nimbusds.jose.jwk.*
import com.nimbusds.jose.jwk.gen.*
import com.nimbusds.jose.util.Base64
import java.util.Base64
import java.security.spec.PKCS8EncodedKeySpec
import java.security.KeyFactory

import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import java.util.UUID
import java.security.cert.X509Certificate
import java.security.KeyPairGenerator
import java.security.KeyPair
import java.math.BigInteger
import java.util.Date
import org.bouncycastle.x509.X509V3CertificateGenerator
import org.bouncycastle.jce.X509Principal
import java.time.ZonedDateTime
import java.time.ZoneOffset
import java.time.format.DateTimeFormatter
import java.time.temporal.ChronoUnit

import org.bouncycastle.jce.provider.BouncyCastleProvider
import java.security.Security






// static x5c partner-device key 
def certString = &quot;&quot;

// static private partner-device key 
def certString2 = &quot;&quot;

// Decode Base64 using Java’s Base64
// OPTIMIZED: parse the static FTM private key once per thread and cache it
def privateKeyFromCertString2 = vars.getObject(&quot;ftmPrivateKeyObj&quot;)
if (privateKeyFromCertString2 == null) {
    byte[] keyBytes = java.util.Base64.getDecoder().decode(certString2)
    def keySpec = new PKCS8EncodedKeySpec(keyBytes)
    def kf = KeyFactory.getInstance(&quot;RSA&quot;)
    privateKeyFromCertString2 = kf.generatePrivate(keySpec)
    vars.putObject(&quot;ftmPrivateKeyObj&quot;, privateKeyFromCertString2)
}

//=========================================

// Convert certificate to Base64 string (DER encoding)
def x5cValue = [ new com.nimbusds.jose.util.Base64(certString) ]

//log.info(&quot;x5cValue: &quot; + x5cValue)

// --- Build JWT header with x5c ---
def header = new JWSHeader.Builder(JWSAlgorithm.RS256)
    .type(JOSEObjectType.JWT)   // &quot;typ&quot;: &quot;JWT&quot;
    .x509CertChain(x5cValue)   // x5c here
    .build()

// Build JWT claims
def nowUTC = ZonedDateTime.now(ZoneOffset.UTC).truncatedTo(ChronoUnit.SECONDS)
def formattedDateTime = nowUTC.format(DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss&apos;Z&apos;&quot;))
def claimsSet = new JWTClaimsSet.Builder()
    .claim(&quot;digitalId&quot;, vars.get(&quot;digitalId_jwt&quot;))
    .claim(&quot;deviceCode&quot;, &quot;b692b595-3523-slap-99fc-bd76e35f290f&quot;)
    .claim(&quot;deviceServiceVersion&quot;, &quot;0.9.5&quot;)
    .claim(&quot;bioType&quot;, &quot;Finger&quot;)
    .claim(&quot;bioSubType&quot;, &quot;UNKNOWN&quot;)
    .claim(&quot;purpose&quot;, &quot;Auth&quot;)
    .claim(&quot;env&quot;, &quot;Developer&quot;)
    .claim(&quot;domainUri&quot;, vars.get(&quot;protocol&quot;)+&quot;://&quot;+vars.get(&quot;serverIP&quot;))
    .claim(&quot;transactionId&quot;, vars.get(&quot;transIDHash&quot;))
    .claim(&quot;requestedScore&quot;, &quot;70&quot;)
    .claim(&quot;qualityScore&quot;, &quot;44&quot;)
    .build()

// Sign JWT
def signedJWT = new SignedJWT(header, claimsSet)
def signer = new RSASSASigner(privateKeyFromCertString2)
signedJWT.sign(signer)

// Store signed JWT
def data_jwt = signedJWT.serialize()
vars.put(&quot;data_jwt&quot;, data_jwt)
//log.info(&quot;Generated data_jwt: &quot; + data_jwt)

//BioChallenge format
def bioChallengeText = &quot;[{\&quot;specVersion\&quot;:\&quot;0.9.5\&quot;,\&quot;data\&quot;:\&quot;&quot; + data_jwt + &quot;\&quot;,\&quot;hash\&quot;:\&quot;7FCE09C083A41A000350C13A8BD6C962FB279AB66A8829D7BA77857EEBC20DC4\&quot;}]&quot;


// --- Base64 encode the bioChallenge ---
def bioChallenge = java.util.Base64.encoder.encodeToString(bioChallengeText.getBytes(&quot;UTF-8&quot;))

// Store the Base64-encoded JWT in a new JMeter variable
vars.put(&quot;bioChallenge&quot;, bioChallenge)
//log.info(&quot;Base64-encoded bioChallenge: &quot; + bioChallenge)

</stringProp>
