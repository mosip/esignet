            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate transIDHash" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Derive a short obfuscated id from the live executionId (mirrors the transIDHash&#xd;
// derivation used by the S02 Biometric flow in Esignet_Test_Script_1.8.1, adapted&#xd;
// to key off executionId instead of the legacy transactionId field).&#xd;
def executionId = vars.get(&quot;executionId&quot;)&#xd;
if (!executionId) {&#xd;
    log.warn(&quot;executionId not found in JMeter variables&quot;)&#xd;
    return&#xd;
}&#xd;
// Remove underscores and hyphens&#xd;
def cleanedId = executionId.replaceAll(&quot;_|-&quot;, &quot;&quot;)&#xd;
// Dynamically set length based on cleanedId&#xd;
def authTransactionIdLength = cleanedId.length()&#xd;
// Convert to bytes&#xd;
def oidcTransactionIdBytes = cleanedId.getBytes(&quot;UTF-8&quot;)&#xd;
def authTransactionIdBytes = new byte[authTransactionIdLength]&#xd;
// Reverse-fill logic&#xd;
int i = oidcTransactionIdBytes.length - 1&#xd;
int j = 0&#xd;
while (j &lt; authTransactionIdLength) {&#xd;
    authTransactionIdBytes[j++] = oidcTransactionIdBytes[i--]&#xd;
    if (i &lt; 0) {&#xd;
        i = oidcTransactionIdBytes.length - 1&#xd;
    }&#xd;
}&#xd;
// Convert back to string&#xd;
def authTransactionId = new String(authTransactionIdBytes, &quot;UTF-8&quot;)&#xd;
// take only first 10 characters&#xd;
authTransactionId = authTransactionId.substring(0, Math.min(10, authTransactionId.length()))&#xd;
// Store result in JMeter variable&#xd;
vars.put(&quot;transIDHash&quot;, authTransactionId)&#xd;
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate digitalId_jwt" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import com.nimbusds.jose.*
import com.nimbusds.jose.crypto.*
import com.nimbusds.jwt.*
import com.nimbusds.jose.jwk.*
import com.nimbusds.jose.jwk.gen.*
import com.nimbusds.jose.util.Base64
import java.util.Base64
import java.security.spec.PKCS8EncodedKeySpec
import java.security.KeyFactory

import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import java.util.UUID
import java.security.cert.X509Certificate
import java.security.KeyPairGenerator
import java.security.KeyPair
import java.math.BigInteger
import java.util.Date
import org.bouncycastle.x509.X509V3CertificateGenerator
import org.bouncycastle.jce.X509Principal
import java.time.ZonedDateTime
import java.time.ZoneOffset
import java.time.format.DateTimeFormatter
import java.time.temporal.ChronoUnit


import org.bouncycastle.jce.provider.BouncyCastleProvider
import java.security.Security

// Register BC provider if not already
if (Security.getProvider(&quot;BC&quot;) == null) {
    Security.addProvider(new BouncyCastleProvider())
}


// static x5c partner-ftm key 
def certString = &quot;&quot;

// static private partner-ftm key 
def certString2 = &quot;&quot;

// Decode Base64 using Java’s Base64
// OPTIMIZED: parse the static FTM private key once per thread and cache it
def privateKeyFromCertString2 = vars.getObject(&quot;ftmPrivateKeyObj&quot;)
if (privateKeyFromCertString2 == null) {
    byte[] keyBytes = java.util.Base64.getDecoder().decode(certString2)
    def keySpec = new PKCS8EncodedKeySpec(keyBytes)
    def kf = KeyFactory.getInstance(&quot;RSA&quot;)
    privateKeyFromCertString2 = kf.generatePrivate(keySpec)
    vars.putObject(&quot;ftmPrivateKeyObj&quot;, privateKeyFromCertString2)
}

