            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate DPoP Proof (Userinfo)" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">/*
 * FAPI2: DPoP proof for userinfo — includes ath (SHA-256 of the access token).
 * Ported from Postman &apos;Exchange Token for Userinfo&apos; pre-request script.
 */
import com.nimbusds.jose.*
import com.nimbusds.jwt.*
import com.nimbusds.jose.jwk.*
import com.nimbusds.jose.crypto.RSASSASigner
import java.util.UUID
import java.util.Date
import java.security.MessageDigest

def rsaJwk = (RSAKey) JWK.parse(vars.get(&quot;dpopPrivateJwk&quot;))
def htu = vars.get(&quot;protocol&quot;) + &quot;://&quot; + vars.get(&quot;serverIP&quot;) + &quot;/v1/esignet/oauth2/userinfo&quot;
def accessToken = vars.get(&quot;access_token&quot;)
def ath = java.util.Base64.getUrlEncoder().withoutPadding()
    .encodeToString(MessageDigest.getInstance(&quot;SHA-256&quot;).digest(accessToken.getBytes(&quot;US-ASCII&quot;)))
def header = new JWSHeader.Builder(JWSAlgorithm.PS256)
    .type(new JOSEObjectType(&quot;dpop+jwt&quot;))
    .jwk(rsaJwk.toPublicJWK())
    .build()
def claims = new JWTClaimsSet.Builder()
    .jwtID(UUID.randomUUID().toString())
    .claim(&quot;htm&quot;, &quot;GET&quot;)
    .claim(&quot;htu&quot;, htu)
    .claim(&quot;ath&quot;, ath)
    .issueTime(new Date())
    .build()
def jwt = new SignedJWT(header, claims)
def signer = new RSASSASigner(rsaJwk)
jwt.sign(signer)
vars.put(&quot;dpopProofUserinfo&quot;, jwt.serialize())</stringProp>
