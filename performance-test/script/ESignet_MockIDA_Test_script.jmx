            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate DPoP Proof (Token)" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">/*
 * FAPI2: DPoP proof for the token endpoint, reusing the key pair generated at PAR.
 * Ported from Postman &apos;Exchange Code for Token&apos; pre-request script.
 */
import com.nimbusds.jose.*
import com.nimbusds.jwt.*
import com.nimbusds.jose.jwk.*
import com.nimbusds.jose.crypto.RSASSASigner
import java.util.UUID
import java.util.Date

def rsaJwk = (RSAKey) JWK.parse(vars.get(&quot;dpopPrivateJwk&quot;))
def htu = vars.get(&quot;protocol&quot;) + &quot;://&quot; + vars.get(&quot;serverIP&quot;) + &quot;/v1/esignet/oauth2/token&quot;
def header = new JWSHeader.Builder(JWSAlgorithm.PS256)
    .type(new JOSEObjectType(&quot;dpop+jwt&quot;))
    .jwk(rsaJwk.toPublicJWK())
    .build()
def claims = new JWTClaimsSet.Builder()
    .jwtID(UUID.randomUUID().toString())
    .claim(&quot;htm&quot;, &quot;POST&quot;)
    .claim(&quot;htu&quot;, htu)
    .issueTime(new Date())
    .build()
def jwt = new SignedJWT(header, claims)
def signer = new RSASSASigner(rsaJwk)
jwt.sign(signer)
vars.put(&quot;dpopProofToken&quot;, jwt.serialize())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Client Assertion PS256 (Token)" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">/*
 * FAPI2: PS256 private_key_jwt client assertion for the token endpoint
 * (aud = https://host/v1/esignet/oauth2/token).
 */
import com.nimbusds.jose.*
import com.nimbusds.jwt.*
import com.nimbusds.jose.jwk.*
import com.nimbusds.jose.crypto.RSASSASigner
import java.util.UUID
import java.util.Date

def jwk = JWK.parse(vars.get(&quot;unencryptedPrivateKey&quot;))
def clientId = vars.get(&quot;userInfoClientId&quot;)
def aud = vars.get(&quot;tokenAudience&quot;)
def kid = jwk.getKeyID()
if (kid == null || kid.isEmpty()) {
    kid = jwk.toPublicJWK().computeThumbprint().toString()
}
def header = new JWSHeader.Builder(JWSAlgorithm.PS256)
    .type(JOSEObjectType.JWT)
    .keyID(kid)
    .build()
def now = new Date()
def claims = new JWTClaimsSet.Builder()
    .issuer(clientId)
    .subject(clientId)
    .audience(aud)
    .jwtID(UUID.randomUUID().toString())
    .issueTime(now)
    .expirationTime(new Date(now.getTime() + 60000))
    .build()
def jwt = new SignedJWT(header, claims)
def signer = new RSASSASigner((RSAKey) jwk)
jwt.sign(signer)
vars.put(&quot;clientAssertionToken&quot;, jwt.serialize())</stringProp>
