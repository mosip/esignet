# ─────────────────────────────────────────────────────────────────────────────
# esignet-service environment variables
#
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# make.sh loads .env automatically when present.
# Precedence: VAR=VALUE on the command line > .env > shell environment > defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP / ThunderID engine ───────────────────────────────────────────────────
# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Listen port (code default: 8088; make.sh defaults to 8080)
# PORT=8080

# OIDC issuer, JWT iss claim, and discovery base URL. Also required to build the default
# resource server's identifier in data/deployment.yaml — must be set (an unset/empty value
# would expand that identifier to a relative path, which is rejected at startup).
MOSIP_ESIGNET_HOST=http://localhost:8080

# Overrides the public URL used for cookie/HTTPS-only detection (defaults to MOSIP_ESIGNET_HOST)
# MOSIP_ESIGNET_BASE_URL=

# Declarative YAML root (flows/, i18n/, layouts/, themes/, keys/)
# DATA_DIR=./data

# JWT signing/encryption is backed by the keymanager module (see the
# "Keymanager" section below) rather than a static key file or crypto key —
# the keymanager auto-provisions its own keys at startup. Reference id of
# the keymanager key JWTs are signed with (default: RSA_2048):
# MOSIP_ESIGNET_SIGNING_KEY_REF_ID=RSA_2048

# Optional OAuth engine overrides (unset = defaults below)
# MOSIP_ESIGNET_OAUTH_AUTH_CODE_LIFETIME_SECONDS=120
# MOSIP_ESIGNET_OAUTH_ACCESS_TOKEN_LIFETIME_SECONDS=3600
# MOSIP_ESIGNET_OAUTH_PAR_EXPIRY_SECONDS=3600

# Login gate redirects for /oauth2/authorize (Thunder gate client)
MOSIP_ESIGNET_OIDC_UI_SCHEME=http
MOSIP_ESIGNET_OIDC_UI_HOSTNAME=localhost
MOSIP_ESIGNET_OIDC_UI_PORT=3000
MOSIP_ESIGNET_OIDC_UI_LOGIN_PATH=/signin
MOSIP_ESIGNET_OIDC_UI_ERROR_PATH=/error

# Declarative flow/theme/layout selection (defaults shown)
# MOSIP_ESIGNET_LAYOUT_ID=layout-esignet
# MOSIP_ESIGNET_THEME_ID=theme-esignet
# MOSIP_ESIGNET_AUTH_FLOW_ID=flow-esignet

# ── PostgreSQL (client management persistence) ────────────────────────────────
# Option A: full DSN (takes precedence over individual vars)
# DATABASE_URL=postgres://esignet:secret@localhost:5432/mosip_esignet?sslmode=disable

# Option B: individual connection params
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mosip_esignet
DATABASE_USERNAME=esignet
# DB_DBUSER_PASSWORD=secret

# Connection pool tuning (optional — defaults shown; the higher values below
# are tuned for production load, local/dev runs generally don't need them)
# DB_MAX_OPEN_CONNS=50
# DB_MAX_IDLE_CONNS=25
# DB_CONN_MAX_LIFETIME_SECS=1800   # 0 = no limit (explicit opt-out)
# DB_CONN_MAX_IDLE_TIME_SECS=300

# ── Cache configuration (redis / inmemory) ─────────────────────────────────────
MOSIP_ESIGNET_CACHE_TYPE=inmemory

# ── Redis (runtime / session store) ──────────────────────────────────────────
# Option A: full DSN  redis://[:password@]host:port/db  or  rediss:// for TLS
# REDIS_URL=redis://:secret@localhost:6379/0

# Option B: individual connection params
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=secret
# REDIS_DB=0

# TLS (automatically enabled for rediss:// URLs)
# REDIS_TLS_ENABLED=false

# Sentinel HA mode (set both to enable; takes precedence over single-node params)
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_ADDRS=sentinel1:26379,sentinel2:26379,sentinel3:26379

# Connection pool tuning (optional — defaults shown)
# REDIS_POOL_SIZE=10
# REDIS_MIN_IDLE_CONNS=2
# REDIS_CONN_MAX_IDLE_TIME_SECS=300
# REDIS_CONN_MAX_LIFETIME_SECS=1800   # 0 = no limit (explicit opt-out)

# Per-operation timeouts in seconds (optional — defaults shown)
# REDIS_DIAL_TIMEOUT_SECS=5
# REDIS_READ_TIMEOUT_SECS=3
# REDIS_WRITE_TIMEOUT_SECS=3
# REDIS_POOL_TIMEOUT_SECS=4           # how long a caller blocks for a pooled conn before failing

# Key namespace prefix — stored as <prefix><type>:<id> (e.g. esignet:flow:<id>)
# REDIS_KEY_PREFIX=esignet:

# ── Outbound / inbound HTTP tuning ────────────────────────────────────────────
# Two independently-tuned outbound clients (ID-system backend calls, captcha
# validation) plus the inbound server's own timeouts. All optional — defaults
# shown. INBOUND_HTTP_SERVER_WRITE_TIMEOUT_SECS must exceed the sum of both
# outbound *_TIMEOUT_SECS below (a single request can invoke both in sequence);
# a mismatch is logged as a startup warning, not enforced.
# OUTBOUND_IDSYSTEM_HTTP_CLIENT_TIMEOUT_SECS=30
# OUTBOUND_IDSYSTEM_HTTP_CLIENT_DIAL_TIMEOUT_SECS=5
# OUTBOUND_IDSYSTEM_HTTP_CLIENT_DIAL_KEEP_ALIVE_SECS=30
# OUTBOUND_IDSYSTEM_HTTP_CLIENT_TLS_HANDSHAKE_TIMEOUT_SECS=10
# OUTBOUND_IDSYSTEM_HTTP_CLIENT_RESPONSE_HEADER_TIMEOUT_SECS=10
# OUTBOUND_IDSYSTEM_HTTP_CLIENT_IDLE_CONN_TIMEOUT_SECS=90
# OUTBOUND_IDSYSTEM_HTTP_CLIENT_MAX_CONNS_PER_HOST=500
# OUTBOUND_IDSYSTEM_HTTP_CLIENT_MAX_IDLE_CONNS=500
# OUTBOUND_IDSYSTEM_HTTP_CLIENT_MAX_IDLE_CONNS_PER_HOST=200
#
# OUTBOUND_HTTP_CLIENT_TIMEOUT_SECS=30                # same fields as above, for captcha validation
# OUTBOUND_HTTP_CLIENT_DIAL_TIMEOUT_SECS=5
# OUTBOUND_HTTP_CLIENT_DIAL_KEEP_ALIVE_SECS=30
# OUTBOUND_HTTP_CLIENT_TLS_HANDSHAKE_TIMEOUT_SECS=10
# OUTBOUND_HTTP_CLIENT_RESPONSE_HEADER_TIMEOUT_SECS=10
# OUTBOUND_HTTP_CLIENT_IDLE_CONN_TIMEOUT_SECS=90
# OUTBOUND_HTTP_CLIENT_MAX_CONNS_PER_HOST=500
# OUTBOUND_HTTP_CLIENT_MAX_IDLE_CONNS=500
# OUTBOUND_HTTP_CLIENT_MAX_IDLE_CONNS_PER_HOST=200
#
# INBOUND_HTTP_SERVER_READ_HEADER_TIMEOUT_SECS=10
# INBOUND_HTTP_SERVER_READ_TIMEOUT_SECS=30
# INBOUND_HTTP_SERVER_WRITE_TIMEOUT_SECS=90    # 30+30 outbound + 30s margin
# INBOUND_HTTP_SERVER_IDLE_TIMEOUT_SECS=120

# ── Keymanager (PKCS12/PKCS11) ────────────────────────────────────────────────
# Cryptographic key lifecycle (JWT signing, cache/session encryption, MOSIP
# partner request signing). Shares the PostgreSQL connection configured above
# (DATABASE_* / DATABASE_URL) — only the schema is separately configurable.
# See internal/keymanager/README.md for the full config/behavior reference.

KEYMANAGER_DB_SCHEMA=esignet

# Keystore backend: PKCS11 (HSM/SoftHSM2, code default, requires a
# CGO_ENABLED=1 build — see make.sh) or PKCS12 (file-based; the only backend
# available in the default CGO_ENABLED=0 local build).
KEYMANAGER_KEYSTORE_TYPE=PKCS12
KEYMANAGER_PKCS12_FILE_PATH=/opt/mosip/test.pfx
KEYMANAGER_PKCS12_PASSWORD=localtest
KEYMANAGER_PKCS12_ALLOW_INSECURE_SOFTWARE_KEYSTORE=true

# KEYMANAGER_PKCS11_MODULE_PATH=
# KEYMANAGER_PKCS11_TOKEN_LABEL=
# KEYMANAGER_PKCS11_SLOT_ID=
# KEYMANAGER_PKCS11_PIN=

# Symmetric key reference ids allowed for GenerateSymmetricKey (comma-separated).
# Default "CACHE_ENCRYPT" covers esignet's own cache/session encryption key,
# auto-provisioned at startup — extend this list only to allow more.
# KEYMANAGER_SYMMETRIC_KEY_ALLOWED_REF_IDS=CACHE_ENCRYPT

# ── Client management API ─────────────────────────────────────────────────────
# Bearer-token scope enforcement on /client-mgmt/* is configured via the
# security_config block in data/deployment.yaml (issuer_url, jwks_url,
# jwks_cache_ttl) — there is no environment-variable override. Enforcement is
# enabled only when both issuer_url and jwks_url are set there; leave them
# empty for local development.

# ── Authentication provider ───────────────────────────────────────────────────
# Authentication provider: mosip (MOSIP IDA) or sunbird (SunbirdRC registry KBI) or mock (mock authentication)
MOSIP_ESIGNET_AUTHN_PROVIDER=mock

# ── Mock authentication (used only when MOSIP_ESIGNET_AUTHN_PROVIDER=mock) ─────────────────
# The mock provider is a thin HTTP client to a running mock-identity-system
# instance (https://github.com/mosip/esignet-mock-services); it does not validate
# credentials or store identities itself. Endpoint URLs default from this domain
# unless overridden individually below.
# MOSIP_ESIGNET_MOCK_DOMAIN_URL=http://mock-identity-system.mockid
MOSIP_ESIGNET_MOCK_DOMAIN_URL=http://localhost:8082

# Optional full URL overrides (leave commented to use MOSIP_ESIGNET_MOCK_DOMAIN_URL defaults)
# MOSIP_ESIGNET_MOCK_KYC_AUTH_URL=http://mock-identity-system.mockid/v1/mock-identity-system/v2/kyc-auth
# MOSIP_ESIGNET_MOCK_KYC_EXCHANGE_URL=http://mock-identity-system.mockid/v1/mock-identity-system/kyc-exchange
# MOSIP_ESIGNET_MOCK_KYC_EXCHANGE_V3_URL=http://mock-identity-system.mockid/v1/mock-identity-system/v3/kyc-exchange
# MOSIP_ESIGNET_MOCK_SEND_OTP_URL=http://mock-identity-system.mockid/v1/mock-identity-system/send-otp

# ── MOSIP ──────────────────────────────────────────────────

# ── IDA authentication ─────────────────────────
# Internal API host; IDA endpoint URLs are derived from this and MOSIP_ESIGNET_MISP_KEY
# unless overridden individually below.
# MOSIP_API_INTERNAL_HOST=https://api-internal.test.mosip.net
# MOSIP_ESIGNET_MISP_KEY=sample-license-key
# MOSIP_IDA_CLIENT_SECRET=test

# IDA request metadata (domainUri defaults to MOSIP_API_INTERNAL_HOST; env defaults to Staging)
# MOSIP_ESIGNET_DOMAIN_URL=https://api-internal.test.mosip.net
# IDA_AUTHENTICATOR_ENV=Staging

# Optional full URL overrides (leave commented to use MOSIP_API_INTERNAL_HOST defaults)
# MOSIP_ESIGNET_AUTHENTICATOR_IDA_CERT_URL=https://api-internal.test.mosip.net/mosip-certs/ida-partner.cer
# MOSIP_ESIGNET_AUTHENTICATOR_IDA_SEND_OTP_URL=https://api-internal.test.mosip.net/idauthentication/v1/otp/<license-key>/
# MOSIP_ESIGNET_AUTHENTICATOR_IDA_KYC_AUTH_URL=https://api-internal.test.mosip.net/idauthentication/v1/kyc-auth/delegated/<license-key>/
# MOSIP_ESIGNET_AUTHENTICATOR_IDA_KYC_EXCHANGE_URL=https://api-internal.test.mosip.net/idauthentication/v1/kyc-exchange/delegated/<license-key>/

# Request signing for MOSIP auth flows uses the keymanager's OIDC_PARTNER /
# RSA_2048 component master key (provisioned at startup) — no separate
# partner keystore configuration is needed.

# ── Observability / audit publishing ───────────────────────
# The observability backend is selected by MOSIP_ESIGNET_AUTHN_PROVIDER (see above), not a
# separate setting:
#   mosip         publish flow lifecycle events to mosip-audit-manager (see below)
#   anything else log event details via the application logger

# Flow lifecycle events are published to mosip-audit-manager when
# MOSIP_ESIGNET_AUTHN_PROVIDER=mosip and an audit endpoint is configured. URLs default from
# MOSIP_API_INTERNAL_HOST unless set here.
# Auth: a token is fetched from authmanager (clientId/secretKey/appId) and sent
# to the audit endpoint as Cookie "Authorization=<token>". When the secret is
# unset, audits are posted without the Authorization cookie.
# MOSIP_ESIGNET_AUDIT_MANAGER_URL=https://api-internal.test.mosip.net/v1/auditmanager/audits
# MOSIP_ESIGNET_AUTH_TOKEN_URL=https://api-internal.test.mosip.net/v1/authmanager/authenticate/clientidsecretkey
# MOSIP_ESIGNET_IDA_CLIENT_ID=mosip-ida-client
# MOSIP_ESIGNET_IDA_CLIENT_SECRET=
# MOSIP_ESIGNET_IDA_APP_ID=ida

# ── SunbirdRC KBI authentication ──────────────────────────────────────────────
# Knowledge-based-identity auth against a SunbirdRC registry. Enabled when
# MOSIP_ESIGNET_AUTHN_PROVIDER=sunbird. The search URL is required.
#
# Registry search endpoint (required; ...auth-factor.kbi.registry-search-url).
# MOSIP_ESIGNET_AUTHENTICATOR_SUNBIRD_RC_AUTH_FACTOR_KBI_REGISTRY_SEARCH_URL=https://registry.dev1.mosip.net/api/v1/Insurance/search
#
# Registry entity (get) endpoint used to fetch attributes (...registry-get-url).
# MOSIP_ESIGNET_AUTHENTICATOR_SUNBIRD_RC_REGISTRY_GET_URL=https://registry.dev1.mosip.net/api/v1/Insurance/
#
# Registry field that the entered individualId maps to in the search filter
# (...auth-factor.kbi.individual-id-field). Default: policyNumber.
# MOSIP_ESIGNET_AUTHENTICATOR_SUNBIRD_RC_AUTH_FACTOR_KBI_INDIVIDUAL_ID_FIELD=policyNumber
#
# Registry field holding the entity id returned by search (...kbi.entity-id-field). Default: osid.
# MOSIP_ESIGNET_AUTHENTICATOR_SUNBIRD_RC_KBI_ENTITY_ID_FIELD=osid
#
# KBI fields collected from the user (JSON array; ...auth-factor.kbi.field-details).
# The individual-id-field entry is the identifier; every other entry is a required credential.
# MOSIP_ESIGNET_AUTHENTICATOR_SUNBIRD_RC_AUTH_FACTOR_KBI_FIELD_DETAILS=[{"id":"policyNumber","type":"text","format":""},{"id":"fullName","type":"text","format":""},{"id":"dob","type":"date","format":"dd/mm/yyyy"}]
#
# OIDC claim -> registry field map (JSON; ...identity-openid-claims-mapping). Empty/unset or malformed = no claims released (fail closed).
# MOSIP_ESIGNET_AUTHENTICATOR_SUNBIRD_RC_IDENTITY_OPENID_CLAIMS_MAPPING={"name":"fullName","email":"email","phone_number":"mobile","gender":"gender","birthdate":"dob"}
#
# HTTP timeout in seconds. Default 10.
# MOSIP_ESIGNET_AUTHENTICATOR_SUNBIRD_RC_REQUEST_TIMEOUT_SECS=10

# ── Captcha validation ────────────────────────────────────────────────────────
# Validation is skipped (token accepted unverified) when the URL is unset.
# MOSIP_ESIGNET_CAPTCHA_VALIDATOR_URL=http://<captcha-service-host>/v1/captcha/validatecaptcha
# MOSIP_ESIGNET_CAPTCHA_MODULE_NAME=esignet
# MOSIP_ESIGNET_CAPTCHA_TIMEOUT_SECS=10
MOSIP_ESIGNET_CAPTCHA_SITE_PROVIDER=hcaptcha
MOSIP_ESIGNET_CAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
